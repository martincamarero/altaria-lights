<section class="relative isolate h-screen w-full overflow-hidden bg-[#030207] px-4 pb-8 pt-24 md:h-screen md:min-h-0 md:px-8 md:pb-[4vh] md:pt-[12vh] lg:px-16" id="hero">
    <video
        class="hero-planet-video"
        data-hero-video
        data-src-mobile="/videos/video-mobile-hero.optimized.mp4"
        data-src-desktop="/videos/video-desk-hero.optimized.mp4"
        poster="/hero-poster.webp"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
    ></video>

    <script is:inline>
        (function () {
            var video = document.querySelector("[data-hero-video]");
            if (!video) return;
            var mq = window.matchMedia("(min-width: 768px)");
            var apply = function () {
                var next = mq.matches
                    ? video.dataset.srcDesktop
                    : video.dataset.srcMobile;
                if (!next || video.getAttribute("src") === next) return;
                video.setAttribute("src", next);
                video.load();
                var playPromise = video.play();
                if (playPromise && typeof playPromise.catch === "function") {
                    playPromise.catch(function () {});
                }
            };
            apply();
            if (mq.addEventListener) {
                mq.addEventListener("change", apply);
            } else if (mq.addListener) {
                mq.addListener(apply);
            }
        })();
    </script>

    <div class="absolute inset-0 z-[1] bg-[radial-gradient(circle_at_50%_78%,rgba(168,85,247,0.18),transparent_35%),linear-gradient(180deg,rgba(3,2,7,0.84)_0%,rgba(3,2,7,0.46)_42%,rgba(3,2,7,0.86)_100%)] md:bg-[radial-gradient(circle_at_72%_48%,rgba(168,85,247,0.22),transparent_32%),linear-gradient(90deg,rgba(3,2,7,0.96)_0%,rgba(3,2,7,0.7)_40%,rgba(3,2,7,0.18)_100%)]"></div>
    <div class="absolute inset-x-0 top-0 z-[2] h-48 bg-gradient-to-b from-[#030207] via-[#030207]/68 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 z-[2] h-64 bg-gradient-to-b from-transparent via-[#050505]/62 to-[#050505]"></div>
    <div class="absolute left-1/2 top-[18%] z-[2] h-px w-[min(760px,80vw)] -translate-x-1/2 bg-gradient-to-r from-transparent via-violet-200/25 to-transparent"></div>
    <div id="particles-container" class="absolute inset-x-0 bottom-0 top-24 z-[3] pointer-events-none"></div>

    <div class="relative z-[4] mx-auto flex h-full w-full max-w-7xl flex-col items-start justify-start gap-8 pt-8 md:h-full md:justify-center md:gap-[3vh] md:pt-0">
        <div class="flex w-full flex-col items-start">
            <h1 class="hero-title-particles font-display w-full text-4xl font-semibold leading-[0.98] tracking-[-0.035em] text-white text-shadow-white md:text-[clamp(2.75rem,5.2vw,4rem)] lg:text-[clamp(3.25rem,calc(3.6vw+2vh),7.5rem)]" data-particle-title>
                Diseño web, software a medida e IA para empresas que quieren <span class="font-serif-accent text-white/95">crecer</span>
            </h1>

            <p class="mt-6 max-w-2xl text-base font-normal leading-8 text-white/76 md:mt-[clamp(0.9rem,2.2vh,1.5rem)] md:max-w-xl md:text-[clamp(1.05rem,1.6vw,1.25rem)] md:leading-[1.55] lg:max-w-3xl lg:text-[clamp(1rem,calc(0.45vw+0.95vh),1.25rem)]">
                Creamos páginas web profesionales, aplicaciones web y automatizaciones con inteligencia artificial para captar más clientes, optimizar procesos y convertir tu presencia digital en un sistema rentable.
            </p>

            <div class="mt-8 flex w-full max-w-md flex-col gap-3 sm:max-w-none sm:flex-row md:mt-[clamp(1rem,2.5vh,2rem)]">
                <a
                    href="#contacto"
                    class="liquid-glass-strong glass-border-cta inline-flex min-h-[clamp(2.5rem,5vh,3rem)] items-center justify-center rounded-full px-[clamp(1.25rem,2vw,1.75rem)] py-2 text-center text-[clamp(0.75rem,calc(0.2vw+0.7vh),0.875rem)] font-semibold uppercase tracking-[0.12em] text-white no-underline shadow-[0_0_38px_rgba(168,85,247,0.3)] transition-all duration-300 hover:scale-105 hover:bg-violet-400/20 active:scale-95"
                >
                    Solicitar propuesta
                </a>
                <a
                    href="#servicios"
                    class="liquid-glass glass-border-soft inline-flex min-h-[clamp(2.5rem,5vh,3rem)] items-center justify-center rounded-full px-[clamp(1.25rem,2vw,1.75rem)] py-2 text-center text-[clamp(0.75rem,calc(0.2vw+0.7vh),0.875rem)] font-semibold uppercase tracking-[0.12em] text-white/86 no-underline transition-all duration-300 hover:scale-105 hover:text-white active:scale-95"
                >
                    Ver servicios digitales
                </a>
            </div>
        </div>
    </div>
</section>

<script src="../scripts/particles.js"></script>
<script src="../scripts/hero-title-particles.js"></script>
