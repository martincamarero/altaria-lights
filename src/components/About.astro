---
type TeamMember = {
    id: string;
    name: string;
    role: string;
    image: string;
};

const teamMembers: TeamMember[] = [
    {
        id: "martin-camarero",
        name: "Martín Camarero",
        role: "CEO & Full-Stack Developer",
        image: "/team/Martin.webp",
    },
    {
        id: "diego-ruano",
        name: "Diego Ruano",
        role: "Lead Developer & Product Lead",
        image: "/team/Diego.webp",
    },
    {
        id: "miguel-angel-copariate",
        name: "Miguel Ángel Copariate",
        role: "Content Creator & Marketing Specialist",
        image: "/team/Miguel.webp",
    },
    {
        id: "hector-lopez",
        name: "Hector López",
        role: "Content Creator & Marketing Specialist",
        image: "/team/Hector.webp",
    },
    {
        id: "oscar-sanchez",
        name: "Óscar Sánchez",
        role: "Marketing & Sales Specialist",
        image: "/team/Oscar.webp",
    },
    {
        id: "rafael-silvela",
        name: "Rafael Silvela",
        role: "Legal & Accounting Advisor",
        image: "/team/Rafael.webp",
    },
    {
        id: "sergio-de-polanco",
        name: "Sergio De Polanco",
        role: "Legal Advisor & Business Strategy",
        image: "/team/Sergio.webp",
    },
    {
        id: "marcos-escudero",
        name: "Marcos Escudero",
        role: "Software & Frontend Developer",
        image: "/team/Marcos.webp",
    },
    {
        id: "guillermo-zamorano",
        name: "Guillermo Zamorano",
        role: "Operations Executive & People Coordinator",
        image: "/team/Guillermo.webp",
    },
];

const initialsOf = (name: string) =>
    name
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("");

const columns = [
    teamMembers.slice(0, 3),
    teamMembers.slice(3, 6),
    teamMembers.slice(6, 9),
];

const aspectVariants = [
    "aspect-[4/5]",
    "aspect-[3/4]",
    "aspect-[4/5]",
    "aspect-[3/4]",
    "aspect-[4/5]",
    "aspect-[3/4]",
    "aspect-[4/5]",
    "aspect-[3/4]",
    "aspect-[4/5]",
];
---

<section
    class="team-section relative overflow-hidden bg-[#050505] text-white"
    id="sobre-nosotros"
    aria-labelledby="team-section-title"
>
    <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(168,85,247,0.18),transparent_36%),radial-gradient(circle_at_85%_82%,rgba(82,51,255,0.16),transparent_38%),linear-gradient(180deg,#050505_0%,#080514_55%,#050505_100%)]"
    >
    </div>

    <div class="relative z-[2] mx-auto w-full max-w-7xl px-4 pt-24 pb-16 md:px-8 lg:px-16 lg:pt-28 lg:pb-24">
        <header class="team-intro max-w-4xl">
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-violet-100/64">
                Equipo Altaria
            </p>
            <h2
                id="team-section-title"
                class="font-display text-3xl font-semibold leading-tight tracking-[-0.035em] text-white sm:text-4xl lg:text-6xl"
            >
                Sobre nosotros
            </h2>
            <p class="mt-6 max-w-3xl text-base leading-7 text-white/70 lg:text-lg lg:leading-8">
                Somos un equipo de nueve profesionales especializados en
                desarrollo de software, inteligencia artificial, marketing, legislación y contabilidad.
                Ayudamos a empresas, emprendedores y profesionales a
                modernizarse, crecer y ahorrar tiempo con herramientas
                digitales prácticas y accesibles.
            </p>
            <p class="mt-4 max-w-3xl text-sm leading-6 text-white/50 lg:text-base lg:leading-7">
                Explicamos cada paso con claridad y acompañamos a cada cliente
                durante todo el proceso. No vendemos tecnología por vender:
                creamos soluciones que de verdad facilitan el trabajo y
                mejoran la presencia online de forma sencilla y humana.
            </p>
        </header>

        <div class="team-board mt-14 lg:mt-20" data-team-board>
            <div class="team-board-desktop">
                <div class="team-grid" aria-hidden="false">
                    {
                        columns.map((column, colIndex) => (
                            <div
                                class={`team-col team-col--${colIndex + 1}`}
                            >
                                {column.map((member, idx) => {
                                    const flatIndex =
                                        colIndex * 3 + idx;
                                    return (
                                        <button
                                            type="button"
                                            class={`team-avatar-card group relative w-full overflow-hidden rounded-[26px] ${aspectVariants[flatIndex]} liquid-glass glass-border-soft`}
                                            data-team-id={member.id}
                                            data-team-trigger="avatar"
                                            aria-label={`Ver ${member.name}, ${member.role}`}
                                        >
                                            <span class="team-placeholder-avatar absolute inset-0">
                                                <span class="team-placeholder-pattern" aria-hidden="true" />
                                                <span class="team-placeholder-orb" aria-hidden="true" />
                                                <span class="team-placeholder-code font-display">
                                                    {initialsOf(member.name)}
                                                </span>
                                            </span>
                                            {member.image && (
                                                <img
                                                    src={member.image}
                                                    alt={member.name}
                                                    class="team-avatar-image absolute inset-0 h-full w-full object-cover"
                                                    loading="lazy"
                                                    decoding="async"
                                                    onerror="this.remove();"
                                                />
                                            )}
                                            <span class="team-avatar-glow" aria-hidden="true" />
                                            <span class="team-avatar-meta">
                                                <span class="team-avatar-name font-display">
                                                    {member.name}
                                                </span>
                                                <span class="team-avatar-role">
                                                    {member.role}
                                                </span>
                                            </span>
                                        </button>
                                    );
                                })}
                            </div>
                        ))
                    }
                </div>

                <ul class="team-list" role="list">
                    {
                        teamMembers.map((member, index) => (
                            <li class="team-member-row" data-team-id={member.id}>
                                <button
                                    type="button"
                                    class="team-member-trigger"
                                    data-team-trigger="row"
                                    aria-label={`Destacar a ${member.name}, ${member.role}`}
                                >
                                    <span class="team-member-node" aria-hidden="true">
                                        <span class="team-member-node-dot" />
                                        <span class="team-member-node-index">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                    </span>
                                    <span class="team-member-info">
                                        <span class="team-member-name font-display">
                                            {member.name}
                                        </span>
                                        <span class="team-member-role">
                                            {member.role}
                                        </span>
                                    </span>
                                </button>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <div class="team-board-mobile">
                <div class="team-carousel" data-team-carousel>
                    {
                        teamMembers.map((member, index) => (
                            <button
                                type="button"
                                class="team-carousel-card liquid-glass glass-border-soft"
                                data-team-id={member.id}
                                data-team-trigger="carousel"
                                aria-label={`Ver ${member.name}, ${member.role}`}
                            >
                                <span class="team-placeholder-avatar absolute inset-0">
                                    <span class="team-placeholder-pattern" aria-hidden="true" />
                                    <span class="team-placeholder-orb" aria-hidden="true" />
                                    <span class="team-placeholder-code font-display">
                                        {initialsOf(member.name)}
                                    </span>
                                </span>
                                {member.image && (
                                    <img
                                        src={member.image}
                                        alt={member.name}
                                        class="team-avatar-image absolute inset-0 h-full w-full object-cover"
                                        loading="lazy"
                                        decoding="async"
                                        onerror="this.remove();"
                                    />
                                )}
                                <span class="team-avatar-glow" aria-hidden="true" />
                                <span class="team-carousel-index">
                                    {String(index + 1).padStart(2, "0")}
                                </span>
                            </button>
                        ))
                    }
                </div>

                <ul class="team-list-mobile" role="list">
                    {
                        teamMembers.map((member, index) => (
                            <li class="team-member-row" data-team-id={member.id}>
                                <button
                                    type="button"
                                    class="team-member-trigger"
                                    data-team-trigger="row-mobile"
                                    aria-label={`Destacar a ${member.name}, ${member.role}`}
                                >
                                    <span class="team-member-node" aria-hidden="true">
                                        <span class="team-member-node-dot" />
                                        <span class="team-member-node-index">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                    </span>
                                    <span class="team-member-info">
                                        <span class="team-member-name font-display">
                                            {member.name}
                                        </span>
                                        <span class="team-member-role">
                                            {member.role}
                                        </span>
                                    </span>
                                </button>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

<script>
    const initTeamSection = () => {
        const board = document.querySelector<HTMLElement>("[data-team-board]");
        if (!board) return;

        const triggers = board.querySelectorAll<HTMLElement>("[data-team-trigger]");
        const targets = board.querySelectorAll<HTMLElement>("[data-team-id]");

        let activeId: string | null = null;

        const setActive = (id: string | null) => {
            if (id === activeId) return;
            activeId = id;
            targets.forEach((el) => {
                const elId = el.dataset.teamId;
                if (!elId) return;
                if (id === null) {
                    el.classList.remove("is-active", "is-dimmed");
                    return;
                }
                if (elId === id) {
                    el.classList.add("is-active");
                    el.classList.remove("is-dimmed");
                } else {
                    el.classList.add("is-dimmed");
                    el.classList.remove("is-active");
                }
            });
        };

        const findId = (node: HTMLElement | null): string | null => {
            let current: HTMLElement | null = node;
            while (current) {
                if (current.dataset?.teamId) return current.dataset.teamId;
                current = current.parentElement;
            }
            return null;
        };

        triggers.forEach((trigger) => {
            const isCarousel = trigger.dataset.teamTrigger === "carousel";

            trigger.addEventListener("mouseenter", () => {
                const id = findId(trigger);
                if (id) setActive(id);
            });
            trigger.addEventListener("focus", () => {
                const id = findId(trigger);
                if (id) setActive(id);
            });
            trigger.addEventListener("mouseleave", () => {
                if (!isCarousel) setActive(null);
            });
            trigger.addEventListener("blur", () => {
                setActive(null);
            });

            if (isCarousel) {
                trigger.addEventListener("click", () => {
                    const id = findId(trigger);
                    if (id) setActive(activeId === id ? null : id);
                });
            }
        });

        board.addEventListener("mouseleave", () => setActive(null));

        const carousel = board.querySelector<HTMLElement>("[data-team-carousel]");
        const scrollCarouselTo = (id: string) => {
            if (!carousel) return;
            const matches = Array.from(
                carousel.querySelectorAll<HTMLElement>(
                    `[data-team-id="${id}"]`,
                ),
            );
            if (!matches.length) return;
            const carRect = carousel.getBoundingClientRect();
            const carCenter = carRect.left + carRect.width / 2;
            let bestSlide = matches[0];
            let bestDist = Infinity;
            matches.forEach((slide) => {
                const r = slide.getBoundingClientRect();
                const dist = Math.abs(r.left + r.width / 2 - carCenter);
                if (dist < bestDist) {
                    bestDist = dist;
                    bestSlide = slide;
                }
            });
            const slideRect = bestSlide.getBoundingClientRect();
            const slideCenter = slideRect.left + slideRect.width / 2;
            const delta = slideCenter - carCenter;
            carousel.scrollTo({
                left: carousel.scrollLeft + delta,
                behavior: "smooth",
            });
        };

        const mobileList = board.querySelector<HTMLElement>(
            ".team-list-mobile",
        );
        if (mobileList && carousel) {
            mobileList
                .querySelectorAll<HTMLElement>(
                    '[data-team-trigger="row-mobile"]',
                )
                .forEach((trigger) => {
                    trigger.addEventListener("click", () => {
                        const id = findId(trigger);
                        if (id) scrollCarouselTo(id);
                    });
                });
        }

        if (carousel) {
            const originals = Array.from(
                carousel.querySelectorAll<HTMLElement>("[data-team-id]"),
            );

            if (originals.length) {
                const attachTriggers = (el: HTMLElement) => {
                    el.addEventListener("mouseenter", () => {
                        const id = findId(el);
                        if (id) setActive(id);
                    });
                    el.addEventListener("focus", () => {
                        const id = findId(el);
                        if (id) setActive(id);
                    });
                    el.addEventListener("click", () => {
                        const id = findId(el);
                        if (id) setActive(activeId === id ? null : id);
                    });
                };

                const cloneSet = (mark: string) => {
                    originals.forEach((node) => {
                        const clone = node.cloneNode(true) as HTMLElement;
                        clone.dataset.teamClone = mark;
                        clone.setAttribute("tabindex", "-1");
                        clone.setAttribute("aria-hidden", "true");
                        carousel.appendChild(clone);
                        attachTriggers(clone);
                    });
                };

                cloneSet("a");
                cloneSet("b");

                let wrapping = false;
                const wrap = () => {
                    if (wrapping) return;
                    const segment = carousel.scrollWidth / 3;
                    if (segment <= 0) return;
                    if (carousel.scrollLeft >= segment * 2) {
                        wrapping = true;
                        carousel.scrollLeft -= segment;
                        requestAnimationFrame(() => {
                            wrapping = false;
                        });
                    } else if (carousel.scrollLeft <= 0) {
                        wrapping = true;
                        carousel.scrollLeft += segment;
                        requestAnimationFrame(() => {
                            wrapping = false;
                        });
                    }
                };

                const settle = () => {
                    requestAnimationFrame(() => {
                        const segment = carousel.scrollWidth / 3;
                        if (segment > 0 && carousel.scrollLeft < 1) {
                            carousel.scrollLeft = segment;
                        }
                    });
                };

                settle();
                window.addEventListener("load", settle, { once: true });
                window.addEventListener("resize", settle);

                carousel.addEventListener("scroll", wrap, { passive: true });

                let isDragging = false;
                let dragStartX = 0;
                let dragStartLeft = 0;
                let dragMoved = false;

                carousel.addEventListener("pointerdown", (e: PointerEvent) => {
                    if (e.pointerType === "touch") return;
                    isDragging = true;
                    dragMoved = false;
                    dragStartX = e.clientX;
                    dragStartLeft = carousel.scrollLeft;
                    carousel.setPointerCapture(e.pointerId);
                    carousel.classList.add("is-dragging");
                });

                carousel.addEventListener("pointermove", (e: PointerEvent) => {
                    if (!isDragging) return;
                    const delta = e.clientX - dragStartX;
                    if (Math.abs(delta) > 4) dragMoved = true;
                    carousel.scrollLeft = dragStartLeft - delta;
                });

                const endDrag = (e: PointerEvent) => {
                    if (!isDragging) return;
                    isDragging = false;
                    try {
                        carousel.releasePointerCapture(e.pointerId);
                    } catch (_err) {
                        /* noop */
                    }
                    carousel.classList.remove("is-dragging");
                };

                carousel.addEventListener("pointerup", endDrag);
                carousel.addEventListener("pointercancel", endDrag);
                carousel.addEventListener("lostpointercapture", () => {
                    isDragging = false;
                    carousel.classList.remove("is-dragging");
                });

                carousel.addEventListener(
                    "click",
                    (e) => {
                        if (dragMoved) {
                            e.stopPropagation();
                            e.preventDefault();
                            dragMoved = false;
                        }
                    },
                    true,
                );

                carousel.addEventListener(
                    "wheel",
                    (e: WheelEvent) => {
                        if (
                            Math.abs(e.deltaY) > Math.abs(e.deltaX) &&
                            e.deltaY !== 0
                        ) {
                            const before = carousel.scrollLeft;
                            carousel.scrollLeft += e.deltaY;
                            if (carousel.scrollLeft !== before) {
                                e.preventDefault();
                            }
                        }
                    },
                    { passive: false },
                );

                const pickCentered = () => {
                    const rect = carousel.getBoundingClientRect();
                    const centerX = rect.left + rect.width / 2;
                    const slides = carousel.querySelectorAll<HTMLElement>(
                        "[data-team-id]",
                    );
                    let bestId: string | null = null;
                    let bestDist = Infinity;
                    slides.forEach((slide) => {
                        const r = slide.getBoundingClientRect();
                        const dist = Math.abs(r.left + r.width / 2 - centerX);
                        if (dist < bestDist) {
                            bestDist = dist;
                            bestId = slide.dataset.teamId || null;
                        }
                    });
                    if (bestId) setActive(bestId);
                };

                let centerScheduled = false;
                const scheduleCenter = () => {
                    if (centerScheduled) return;
                    centerScheduled = true;
                    requestAnimationFrame(() => {
                        pickCentered();
                        centerScheduled = false;
                    });
                };

                carousel.addEventListener("scroll", scheduleCenter, {
                    passive: true,
                });
                window.addEventListener("resize", scheduleCenter);

                requestAnimationFrame(() => {
                    requestAnimationFrame(pickCentered);
                });
            }
        }

        if ("IntersectionObserver" in window) {
            const section = document.getElementById("sobre-nosotros");
            if (section) {
                const revealObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                section.classList.add("is-revealed");
                                revealObserver.disconnect();
                            }
                        });
                    },
                    { threshold: 0.12 },
                );
                revealObserver.observe(section);
            }
        }
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTeamSection);
    } else {
        initTeamSection();
    }
</script>

<style>
    .team-section {
        isolation: isolate;
    }

    .team-intro {
        opacity: 0;
        transform: translateY(18px);
        transition:
            opacity 0.7s ease,
            transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .team-board {
        opacity: 0;
        transform: translateY(28px);
        transition:
            opacity 0.8s ease 0.12s,
            transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
    }

    .team-section.is-revealed .team-intro,
    .team-section.is-revealed .team-board {
        opacity: 1;
        transform: translateY(0);
    }

    .team-board-desktop {
        display: none;
    }

    .team-board-mobile {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    @media (min-width: 1280px) {
        .team-board-desktop {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
            gap: clamp(2.5rem, 5vw, 5rem);
            align-items: start;
        }

        .team-board-mobile {
            display: none;
        }
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.9rem;
    }

    .team-col {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .team-col--1 {
        padding-top: 0;
    }
    .team-col--2 {
        padding-top: 3.5rem;
    }
    .team-col--3 {
        padding-top: 1.75rem;
    }

    @media (min-width: 1280px) {
        .team-col--2 {
            padding-top: 4.5rem;
        }
        .team-col--3 {
            padding-top: 2.25rem;
        }
        .team-grid {
            gap: 1.1rem;
        }
        .team-col {
            gap: 1.1rem;
        }
    }

    .team-avatar-card {
        position: relative;
        display: block;
        padding: 0;
        border: none;
        cursor: pointer;
        color: inherit;
        background: transparent;
        transition:
            transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
            opacity 0.45s ease,
            filter 0.45s ease,
            box-shadow 0.5s ease;
        text-align: left;
        will-change: transform, opacity, filter;
    }

    .team-avatar-card:focus-visible {
        outline: 2px solid rgba(196, 181, 253, 0.7);
        outline-offset: 3px;
    }

    .team-avatar-card:hover {
        transform: translateY(-4px);
    }

    .team-placeholder-avatar {
        display: flex;
        align-items: flex-end;
        justify-content: flex-start;
        padding: 1rem;
        background:
            radial-gradient(circle at 30% 22%, rgba(196, 181, 253, 0.32), transparent 55%),
            radial-gradient(circle at 78% 82%, rgba(82, 51, 255, 0.36), transparent 60%),
            linear-gradient(155deg, rgba(36, 18, 78, 0.95), rgba(14, 8, 28, 0.95));
    }

    .team-placeholder-pattern {
        position: absolute;
        inset: 0;
        background-image:
            radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
            radial-gradient(rgba(196, 181, 253, 0.05) 1px, transparent 1px);
        background-size: 18px 18px, 28px 28px;
        background-position: 0 0, 9px 9px;
        opacity: 0.7;
        mix-blend-mode: screen;
        pointer-events: none;
    }

    .team-placeholder-orb {
        position: absolute;
        top: 28%;
        left: 50%;
        width: 58%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background:
            radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.22), transparent 55%),
            radial-gradient(circle at 60% 70%, rgba(168, 85, 247, 0.55), transparent 60%),
            linear-gradient(140deg, rgba(196, 181, 253, 0.35), rgba(82, 51, 255, 0.55));
        box-shadow:
            inset 0 1px 2px rgba(255, 255, 255, 0.32),
            0 18px 60px rgba(82, 51, 255, 0.45);
        filter: blur(0.4px);
    }

    .team-placeholder-orb::after {
        content: "";
        position: absolute;
        inset: -14%;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(196, 181, 253, 0.22), transparent 60%);
        filter: blur(16px);
        z-index: -1;
    }

    .team-placeholder-code {
        position: absolute;
        top: 0.95rem;
        right: 1.05rem;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: rgba(255, 255, 255, 0.88);
        padding: 0.25rem 0.55rem;
        border-radius: 999px;
        background: rgba(8, 5, 18, 0.55);
        box-shadow:
            inset 0 1px 1px rgba(255, 255, 255, 0.16),
            0 0 0 1px rgba(196, 181, 253, 0.18);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .team-placeholder-tag {
        position: relative;
        z-index: 2;
        font-size: 0.62rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(196, 181, 253, 0.7);
    }

    .team-avatar-image {
        z-index: 1;
    }

    .team-avatar-glow {
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        background: linear-gradient(150deg, rgba(196, 181, 253, 0.32), transparent 45%, rgba(168, 85, 247, 0.32));
        opacity: 0;
        transition: opacity 0.45s ease;
        pointer-events: none;
        mix-blend-mode: screen;
        z-index: 2;
