---
const navLinks = [
    { label: "Inicio", href: "/#hero" },
    { label: "Soluciones", href: "/#soluciones" },
    { label: "Por qué Altaria", href: "/#por-que-altaria" },
    { label: "Servicios", href: "/#servicios" },
    { label: "Sobre Nosotros", href: "/#sobre-nosotros" },
    { label: "FAQ", href: "/#faq" },
    { label: "Contacto", href: "/#contacto" },
];

const legalLinks = [
    { label: "Aviso Legal", href: "/aviso-legal" },
    { label: "Términos y condiciones", href: "/terminos-condiciones" },
];

const year = new Date().getFullYear();
---

<footer class="footer-section relative z-[2] w-full overflow-hidden bg-[#050505] text-white">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_88%_4%,rgba(168,85,247,0.16),transparent_38%),radial-gradient(circle_at_8%_92%,rgba(82,51,255,0.14),transparent_38%),linear-gradient(180deg,#050505_0%,#080514_60%,#040309_100%)]"></div>

    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-violet-300/30 to-transparent"></div>

    <div class="relative z-[2] mx-auto w-full max-w-7xl px-4 pb-8 pt-16 md:px-8 lg:px-16 lg:pt-20">

        <div class="footer-shell liquid-glass-strong glass-border-soft relative overflow-hidden rounded-[32px] p-7 sm:p-10 lg:p-12">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_92%_8%,rgba(196,181,253,0.12),transparent_36%)]"></div>

            <div class="relative z-[2] grid gap-10 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-14">

                <div class="footer-brand flex flex-col gap-6">
                    <a href="/" class="group inline-flex items-center gap-3 no-underline">
                        <span class="relative grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white/[0.04] shadow-[0_0_34px_rgba(134,106,250,0.36)] ring-1 ring-white/[0.04]">
                            <img src="/logo-morado.png" alt="Logo Altaria Lights" class="h-9 w-9 rounded-full" />
                        </span>
                        <span class="font-display text-xl font-semibold leading-tight tracking-[-0.015em] text-white">Altaria Lights</span>
                    </a>

                    <p class="max-w-md text-sm leading-7 text-white/64 lg:text-base">
                        Diseño web profesional, software a medida, automatización e inteligencia artificial para empresas que quieren crecer con criterio.
                    </p>

                    <div class="flex flex-wrap items-center gap-2">
                        <a href="mailto:altarialights@gmail.com" aria-label="Enviar email a Altaria Lights" class="footer-social inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.05] text-white/82 no-underline ring-1 ring-white/[0.05] transition duration-300 hover:-translate-y-0.5 hover:bg-violet-300/16 hover:text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                                <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                            </svg>
                        </a>
                        <a href="https://www.linkedin.com/in/mart%C3%ADn-camarero-benavente-7323b2222/" target="_blank" rel="noopener" aria-label="LinkedIn de Altaria Lights" class="footer-social inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.05] text-white/82 no-underline ring-1 ring-white/[0.05] transition duration-300 hover:-translate-y-0.5 hover:bg-violet-300/16 hover:text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                                <path d="M4.98 3.5c0 1.38-1.12 2.5-2.5 2.5S0 4.88 0 3.5C0 2.12 1.12 1 2.5 1S4.98 2.12 4.98 3.5zM.22 8.5h4.56V24H.22V8.5zM8.5 8.5h4.37v2.12h.06c.61-1.15 2.1-2.36 4.33-2.36 4.63 0 5.48 3.05 5.48 7.02V24h-4.56v-7c0-1.67-.03-3.82-2.33-3.82-2.33 0-2.69 1.82-2.69 3.7V24H8.5V8.5z" />
                            </svg>
                        </a>
                        <a href="/#contacto" class="footer-cta inline-flex min-h-11 items-center gap-2 rounded-full bg-violet-300/16 px-5 text-sm font-semibold text-white no-underline shadow-[0_0_30px_rgba(168,85,247,0.2)] transition duration-300 hover:-translate-y-0.5 hover:bg-violet-300/24">
                            Reservar reunión
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                        </a>
                    </div>
                </div>

                <nav class="footer-nav" aria-label="Navegación">
                    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-violet-100/56">Navegación</p>
                    <ul class="mt-5 flex flex-col gap-2.5 sm:grid sm:grid-cols-2 lg:flex lg:flex-col">
                        {navLinks.map((link) => (
                            <li class="list-none">
                                <a href={link.href} class="footer-link group inline-flex items-center gap-2 text-sm font-medium text-white/72 no-underline transition duration-300 hover:text-white">
                                    <span class="footer-link-text">{link.label}</span>
                                    <span class="footer-link-arrow inline-flex translate-x-0 opacity-0 transition duration-300 group-hover:translate-x-1 group-hover:opacity-100">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>

                <div class="footer-legal">
                    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-violet-100/56">Legal</p>
                    <ul class="mt-5 flex flex-col gap-2.5">
                        {legalLinks.map((link) => (
                            <li class="list-none">
                                <a href={link.href} class="footer-link inline-flex items-center text-sm font-medium text-white/64 no-underline transition duration-300 hover:text-white">
                                    <span class="footer-link-text">{link.label}</span>
                                </a>
                            </li>
                        ))}
                    </ul>

                    <div class="mt-8">
                        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-violet-100/56">Ubicación</p>
                        <p class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-white/72">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-violet-200/80">
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" />
                            </svg>
                            Toledo · España
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/[0.05] pt-6 text-center sm:flex-row sm:text-left">
            <p class="text-xs text-white/52 sm:text-sm">&copy; {year} Altaria Lights.</p>
            <p class="inline-flex items-center gap-2 text-xs text-white/42 sm:text-sm">
                <span class="block h-1.5 w-1.5 rounded-full bg-violet-300 shadow-[0_0_10px_rgba(196,181,253,0.7)]"></span>
                Disponible para nuevos proyectos
            </p>
        </div>
    </div>
</footer>
