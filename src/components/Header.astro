<header
    id="main-header"
    class="liquid-glass-strong glass-border-premium fixed left-3 right-3 top-3 z-[1600] flex h-[68px] items-center justify-between rounded-[28px] px-3 transition-all duration-300 sm:left-5 sm:right-5 md:left-8 md:right-8 md:px-5 lg:left-1/2 lg:right-auto lg:w-[min(1280px,calc(100%-128px))] lg:-translate-x-1/2"
>
    <a href="/" class="group flex min-w-0 items-center gap-3 no-underline">
        <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/[0.04] shadow-[0_0_34px_rgba(134,106,250,0.36)]">
            <img class="h-8 w-8 rounded-full" src="/logo-morado.png" alt="Logo Altaria Lights" />
        </span>
        <span class="min-w-0">
            <span class="font-display block truncate text-base font-semibold leading-snug tracking-[-0.01em] text-white md:text-lg">Altaria Lights</span>
            <span class="mt-1 hidden text-[11px] font-medium uppercase tracking-[0.18em] text-violet-100/50 sm:block">AI Studio</span>
        </span>
    </a>

    <nav class="hidden items-center gap-1 rounded-full bg-white/[0.035] p-1 lg:flex">
        <a href="/#hero" class="rounded-full px-4 py-2 text-sm font-medium tracking-[-0.005em] text-white/68 no-underline transition duration-300 hover:bg-white/[0.06] hover:text-white">Inicio</a>
        <a href="/#servicios" class="rounded-full px-4 py-2 text-sm font-medium tracking-[-0.005em] text-white/68 no-underline transition duration-300 hover:bg-white/[0.06] hover:text-white">Servicios</a>
        <a href="/#sobre-nosotros" class="rounded-full px-4 py-2 text-sm font-medium tracking-[-0.005em] text-white/68 no-underline transition duration-300 hover:bg-white/[0.06] hover:text-white">Estudio</a>
        <a href="/#contacto" class="rounded-full px-4 py-2 text-sm font-medium tracking-[-0.005em] text-white/68 no-underline transition duration-300 hover:bg-white/[0.06] hover:text-white">Contacto</a>
    </nav>

    <div class="flex items-center gap-2">
        <a
            href="/#contacto"
            class="hidden min-h-11 items-center justify-center rounded-full bg-white/[0.08] px-5 text-sm font-semibold tracking-[-0.005em] text-white no-underline shadow-[0_0_28px_rgba(168,85,247,0.18)] transition duration-300 hover:scale-105 hover:bg-violet-400/15 md:inline-flex"
        >
            Empezar proyecto
        </a>

        <button
            class="menu-toggle group flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full bg-white/[0.06] transition duration-300 hover:bg-white/[0.1] lg:hidden"
            id="menu-toggle"
            type="button"
            aria-label="Abrir menú"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<div
    class="menu-overlay fixed left-0 top-0 z-[1000] flex h-screen w-screen items-center justify-center overflow-hidden bg-[#05030a]/95 backdrop-blur-2xl pointer-events-none"
    id="menu-overlay"
>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(168,85,247,0.2),transparent_34%),linear-gradient(180deg,rgba(255,255,255,0.04),transparent_38%)]"></div>
    <nav class="relative z-10 w-full max-w-sm px-6">
        <ul class="liquid-glass-strong list-none rounded-[32px] p-4 text-left">
            <li><a href="/#hero" class="mobile-menu-link">Inicio</a></li>
            <li><a href="/#servicios" class="mobile-menu-link">Servicios</a></li>
            <li><a href="/#sobre-nosotros" class="mobile-menu-link">Estudio</a></li>
            <li><a href="/#contacto" class="mobile-menu-link">Contacto</a></li>
            <li><a href="terminos-condiciones" class="mobile-menu-link text-white/62">Términos y condiciones</a></li>
            <li><a href="aviso-legal" class="mobile-menu-link text-white/62">Aviso Legal</a></li>
        </ul>
    </nav>
</div>

<script src="../scripts/header.js"></script>
