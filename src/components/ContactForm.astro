---
const benefits = [
    {
        title: "Reunión inicial gratuita",
        text: "Te orientamos sin compromiso antes de hablar de presupuesto.",
        icon: "calendar",
    },
    {
        title: "Presupuesto personalizado",
        text: "Cada propuesta se adapta a tu caso, tus tiempos y tu negocio.",
        icon: "spark",
    },
    {
        title: "Respuesta humana en 24 h",
        text: "Una persona lee tu mensaje y te contesta cuanto antes.",
        icon: "mail",
    },
];
---

<section class="contact-section relative overflow-hidden bg-[#050505] text-white" id="contacto" aria-labelledby="contact-title">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_88%_8%,rgba(168,85,247,0.18),transparent_36%),radial-gradient(circle_at_6%_92%,rgba(82,51,255,0.16),transparent_36%),linear-gradient(180deg,#050505_0%,#090614_50%,#050505_100%)]"></div>

    <div class="relative z-[2] mx-auto w-full max-w-7xl px-4 py-24 md:px-8 lg:px-16 lg:py-32">
        <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">

            <aside class="contact-sidebar hidden flex-col gap-8 lg:flex">
                <header>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-100/64">Empieza tu proyecto</p>
                    <h2 id="contact-title" class="font-display mt-4 text-3xl font-semibold leading-tight tracking-[-0.035em] text-white sm:text-4xl lg:text-5xl">
                        Cuéntanos qué necesitas y te respondemos en menos de 24 h
                    </h2>
                    <p class="mt-5 max-w-xl text-base leading-7 text-white/70 lg:text-lg lg:leading-8">
                        Diseño web profesional, software a medida, automatización o estrategia digital. Nos cuentas qué necesitas, revisamos tu caso y te preparamos una propuesta clara con presupuesto personalizado.
                    </p>
                </header>

                <ul class="flex flex-col gap-3" role="list">
                    {benefits.map((benefit) => (
                        <li class="contact-benefit liquid-glass glass-border-soft relative overflow-hidden rounded-[22px] p-4 sm:p-5">
                            <div class="relative z-[2] flex items-start gap-3">
                                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-violet-300/14 ring-1 ring-white/[0.06]">
                                    {benefit.icon === "calendar" && (
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-violet-100">
                                            <path d="M8 2v3" /><path d="M16 2v3" /><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18" /><path d="m9 15 2 2 4-4" />
                                        </svg>
                                    )}
                                    {benefit.icon === "spark" && (
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-violet-100">
                                            <path d="M12 3v3" /><path d="M12 18v3" /><path d="M5.6 5.6l2.1 2.1" /><path d="M16.3 16.3l2.1 2.1" /><path d="M3 12h3" /><path d="M18 12h3" /><path d="M5.6 18.4l2.1-2.1" /><path d="M16.3 7.7l2.1-2.1" /><circle cx="12" cy="12" r="3" />
                                        </svg>
                                    )}
                                    {benefit.icon === "mail" && (
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-violet-100">
                                            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                                        </svg>
                                    )}
                                </span>
                                <div class="min-w-0">
                                    <p class="font-display text-base font-semibold tracking-[-0.015em] text-white">{benefit.title}</p>
                                    <p class="mt-1 text-sm leading-6 text-white/64">{benefit.text}</p>
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </aside>

            <form
                action="https://formspree.io/f/mblyapdd"
                method="POST"
                class="contact-form liquid-glass-strong glass-border-premium relative overflow-hidden rounded-[32px] p-6 sm:p-8 lg:p-10"
                id="contact-form"
                aria-labelledby="contact-form-title"
            >
                <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_92%_4%,rgba(196,181,253,0.16),transparent_38%),radial-gradient(circle_at_8%_96%,rgba(82,51,255,0.14),transparent_38%)]"></div>

                <div class="relative z-[2] flex flex-col">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-violet-100/64">Contacto</p>
                            <h3 id="contact-form-title" class="font-display mt-2 text-2xl font-semibold leading-tight tracking-[-0.025em] text-white lg:text-3xl">
                                Cuéntanos tu proyecto
                            </h3>
                        </div>
                        <span class="inline-flex items-center gap-2 rounded-full bg-violet-300/14 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-violet-100/82">
                            <span class="block h-1.5 w-1.5 rounded-full bg-violet-200 shadow-[0_0_10px_rgba(196,181,253,0.9)]"></span>
                            Disponible
                        </span>
                    </div>

                    <div class="contact-fields mt-7 flex flex-col gap-5">
                        <div class="contact-field">
                            <label for="name" class="contact-label">Nombre</label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                autocomplete="name"
                                placeholder="Tu nombre"
                                class="contact-input"
                            />
                        </div>

                        <div class="contact-field">
                            <label for="email" class="contact-label">Correo electrónico</label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                autocomplete="email"
                                placeholder="tu@email.com"
                                class="contact-input"
                            />
                        </div>

                        <div class="contact-field">
                            <label for="message" class="contact-label">¿Qué necesitas?</label>
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                required
                                placeholder="Cuéntanos qué tienes ahora, qué quieres conseguir y cualquier detalle que nos ayude a entender tu caso."
                                class="contact-input contact-textarea"
                            ></textarea>
                        </div>

                        <button type="submit" class="contact-submit">
                            <span>Enviar mensaje</span>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-submit-icon h-4 w-4">
                                <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                            </svg>
                        </button>

                        <p id="form-status" class="contact-status" role="status" aria-live="polite"></p>

                        <p class="contact-fineprint">
                            Al enviar este formulario aceptas que te contactemos sobre tu consulta. No usamos tus datos para nada más.
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<script src="../scripts/form.js"></script>
