---
const solutions = [
    {
        number: "01",
        phase: "Diagnóstico",
        title: "Diagnóstico gratuito",
        text:
            "Revisamos tu web, tus procesos y tus herramientas actuales para entender qué falla, qué se puede mejorar y qué solución tiene más sentido para tu negocio.",
        chips: ["Auditoría inicial", "Prioridades", "Hoja de ruta"],
    },
    {
        number: "02",
        phase: "Web",
        title: "Web profesional y preparada para vender",
        text:
            "Creamos páginas web modernas, rápidas y claras, pensadas para transmitir confianza, posicionar mejor en Google y convertir visitas en contactos.",
        chips: ["Diseño web profesional", "SEO", "Conversión"],
    },
    {
        number: "03",
        phase: "Software",
        title: "Software a medida para tu forma de trabajar",
        text:
            "Desarrollamos herramientas internas, paneles, CRMs o aplicaciones web adaptadas a tus procesos reales, no al revés.",
        chips: ["Software a medida", "Aplicaciones web", "CRM"],
    },
    {
        number: "04",
        phase: "IA",
        title: "Automatización e inteligencia artificial",
        text:
            "Reducimos tareas repetitivas, conectamos herramientas y aplicamos IA donde realmente ahorra tiempo, evita errores o mejora la atención al cliente.",
        chips: ["Automatización", "IA para empresas", "Integraciones"],
    },
    {
        number: "05",
        phase: "Marketing",
        title: "Marketing, SEO y captación",
        text:
            "Ordenamos tu presencia digital para que web, contenido, campañas y medición trabajen juntos con un objetivo: generar oportunidades reales.",
        chips: ["Marketing digital", "Captación", "Contenido"],
    },
    {
        number: "06",
        phase: "Medición",
        title: "Medición y mejora continua",
        text:
            "No dejamos la solución en el aire. Medimos, ajustamos y te ayudamos a evolucionar el sistema según crece tu empresa.",
        chips: ["Analítica", "Mejora continua", "Evolución"],
    },
];
---

<section class="solutions-section relative overflow-hidden bg-[#050505] text-white" id="soluciones">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_10%,rgba(82,51,255,0.18),transparent_30%),radial-gradient(circle_at_86%_28%,rgba(168,85,247,0.14),transparent_32%),linear-gradient(180deg,#050505_0%,#090614_48%,#050505_100%)]"></div>

    <div class="solutions-intro solutions-desktop-intro relative z-[2] mx-auto max-w-7xl px-4 pb-10 pt-24 md:px-8 lg:px-16 lg:pt-28">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-violet-100/64">Cómo lo resolvemos</p>
        <h2 class="font-display max-w-5xl text-3xl font-semibold leading-tight tracking-[-0.035em] text-white sm:text-4xl lg:text-6xl">
            Diseñamos el sistema digital que tu empresa necesita para avanzar
        </h2>
        <p class="mt-6 max-w-3xl text-base leading-7 text-white/70 lg:text-lg lg:leading-8">
            Analizamos tu situación, detectamos qué está frenando tu crecimiento y construimos una solución clara: una web profesional, software a medida, automatizaciones con IA o una estrategia digital preparada para captar más oportunidades.
        </p>
    </div>

    <div class="solutions-mobile-flow relative z-[2] mx-auto w-full max-w-7xl px-4 pb-8 pt-18">
        <div>
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-violet-100/64">Cómo lo resolvemos</p>
            <h2 class="font-display text-3xl font-semibold leading-tight tracking-[-0.035em] text-white">
                Un sistema claro para avanzar
            </h2>
            <p class="mt-4 text-base leading-7 text-white/68">
                Detectamos qué está frenando tu negocio y construimos la solución adecuada: web, software, automatización, IA o marketing.
            </p>
        </div>

        <div class="solutions-mobile-dashboard liquid-glass-strong mt-8 rounded-[30px] p-5">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_76%_28%,rgba(168,85,247,0.18),transparent_36%)]"></div>
            <div class="relative z-[2]">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-100/54">Altaria System</p>
                        <p class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-white/42">Fase actual</p>
                        <p class="solutions-active-phase font-display mt-2 text-3xl font-semibold tracking-[-0.04em] text-white">Diagnóstico</p>
                    </div>
                    <span class="solutions-mobile-counter rounded-full bg-violet-300/12 px-3 py-1 text-xs font-semibold text-violet-100/82">01/06</span>
                </div>

                <p class="solutions-active-copy mt-3 max-w-[16rem] text-sm leading-6 text-white/62">Ordenamos la situación antes de proponer una solución.</p>

                <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-white/[0.07]">
                    <div class="solutions-mobile-progress h-full w-1/6 rounded-full bg-violet-200 shadow-[0_0_18px_rgba(168,85,247,0.48)]"></div>
                </div>

                <div class="mt-5 grid grid-cols-6 gap-1.5">
                    {solutions.map((solution, index) => (
                        <button class={`solutions-node solutions-mobile-dot grid h-8 place-items-center rounded-full bg-white/[0.055] text-[0.68rem] font-semibold text-white/58 ring-1 ring-white/[0.04] transition duration-300 ${index === 0 ? 'is-active' : ''}`} type="button" data-solution-node={index} data-mobile-solution-dot={index} aria-label={`Ver fase ${solution.number}: ${solution.phase}`}>
                            {solution.number}
                        </button>
                    ))}
                </div>

                <img
                    src="/solution.png"
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="pointer-events-none absolute bottom-[3.8rem] right-[1.2rem] h-[112px] w-auto select-none object-contain opacity-80 drop-shadow-[0_20px_42px_rgba(168,85,247,0.44)]"
                />
            </div>
        </div>

        <div class="solutions-mobile-carousel mt-7" aria-label="Soluciones de Altaria Lights">
            {solutions.map((solution, index) => (
                <article class={`solutions-mobile-slide solution-card liquid-glass rounded-[28px] p-5 ${index === 0 ? 'is-active' : ''}`} data-mobile-solution-slide data-index={index} data-phase={solution.phase}>
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <span class="font-display text-sm font-semibold text-violet-100/60">{solution.number}</span>
                            <h3 class="font-display mt-3 text-2xl font-semibold leading-tight tracking-[-0.025em] text-white">{solution.title}</h3>
                        </div>
                        <span class="rounded-full bg-white/[0.055] px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-white/58">{solution.phase}</span>
                    </div>

                    <p class="mt-5 text-base leading-7 text-white/68">{solution.text}</p>

                    <div class="mt-6 flex flex-wrap gap-2">
                        {solution.chips.map((chip) => (
                            <span class="rounded-full bg-white/[0.055] px-3 py-2 text-sm font-medium leading-none text-white/70 ring-1 ring-white/[0.04]">{chip}</span>
                        ))}
                    </div>
                </article>
            ))}
        </div>
    </div>

    <div class="solutions-pin-stage solutions-desktop-flow relative z-[2]">
        <div class="solutions-layout mx-auto grid w-full max-w-7xl gap-8 px-4 py-10 md:px-8 md:py-8 lg:grid-cols-[0.92fr_1.08fr] lg:px-16">
            <aside class="solutions-dashboard liquid-glass-strong min-h-[430px] overflow-hidden rounded-[34px] p-6 lg:min-h-[520px]">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(168,85,247,0.15),transparent_34%)]"></div>
                <div class="relative z-[2] flex h-full flex-col">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-violet-100/54">Altaria System</p>
                            <h3 class="font-display mt-3 text-3xl font-semibold tracking-[-0.035em] text-white">Centro de control</h3>
                        </div>
                        <span class="rounded-full bg-violet-300/12 px-3 py-1 text-xs font-semibold text-violet-100/82">Activo</span>
                    </div>

                    <div class="my-6 h-px bg-violet-100/12"></div>

                    <div class="rounded-[28px] bg-white/[0.045] p-5 ring-1 ring-white/[0.04]">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/45">Fase actual</p>
                        <p class="solutions-active-phase font-display mt-3 text-4xl font-semibold tracking-[-0.045em] text-white">Diagnóstico</p>
                        <p class="solutions-active-copy mt-4 text-sm leading-6 text-white/62">Ordenamos la situación antes de proponer una solución.</p>
                    </div>

                    <div class="relative mt-6 flex-1">
                        <div class="absolute left-[27px] top-6 h-[calc(100%-3rem)] w-px bg-gradient-to-b from-violet-200/30 via-violet-300/14 to-transparent"></div>
                        <div class="solutions-node-list grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
                            {solutions.map((solution, index) => (
                                <div class={`solutions-node flex items-center gap-3 rounded-2xl px-3 py-2 transition duration-300 ${index === 0 ? 'is-active' : ''}`} data-solution-node={index} data-phase={solution.phase}>
                                    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/[0.06] text-xs font-semibold text-white/64 ring-1 ring-white/[0.05]">{solution.number}</span>
                                    <span class="text-sm font-medium text-white/58">{solution.phase}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <img
                        src="/solution.png"
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        class="pointer-events-none absolute bottom-[-8%] right-[-10%] hidden h-[230px] w-auto select-none object-contain opacity-80 drop-shadow-[0_24px_50px_rgba(168,85,247,0.45)] xl:block"
                    />
                </div>
            </aside>

            <div class="solutions-card-stage">
                {solutions.map((solution, index) => (
                    <article class={`solution-card liquid-glass rounded-[28px] p-5 transition duration-500 md:p-6 lg:p-8 ${index === 0 ? 'is-active' : ''}`} data-solution-card data-index={index} data-phase={solution.phase}>
                        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                            <div>
                                <span class="font-display text-sm font-semibold text-violet-100/60">{solution.number}</span>
                                <h3 class="font-display mt-3 text-2xl font-semibold leading-tight tracking-[-0.025em] text-white lg:text-4xl">{solution.title}</h3>
                            </div>
                            <span class="w-fit rounded-full bg-white/[0.055] px-3 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-white/58">{solution.phase}</span>
                        </div>

                        <p class="mt-6 max-w-3xl text-base leading-7 text-white/68 lg:text-xl lg:leading-9">{solution.text}</p>

                        <div class="mt-7 flex flex-wrap gap-2">
                            {solution.chips.map((chip) => (
                                <span class="rounded-full bg-white/[0.055] px-3 py-2 text-sm font-medium leading-none text-white/70 ring-1 ring-white/[0.04] lg:px-4 lg:py-2.5">{chip}</span>
                            ))}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </div>

    <div class="solutions-cta relative z-[2] mx-auto max-w-7xl px-4 pb-20 pt-10 lg:px-16 lg:pb-28">
        <div class="liquid-glass-strong glass-border-cta rounded-[32px] p-6 text-center lg:p-9">
            <h3 class="font-display text-3xl font-semibold leading-tight tracking-[-0.03em] text-white lg:text-4xl">
                Agendamos una reunión gratuita y vemos tu caso
            </h3>
            <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-white/70 lg:text-lg">
                Nos cuentas qué está pasando, revisamos tu situación y te proponemos una solución clara con presupuesto personalizado.
            </p>
            <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
                <a href="#contacto" class="inline-flex min-h-12 items-center justify-center rounded-full bg-violet-300/18 px-6 py-3 text-sm font-semibold text-white no-underline shadow-[0_0_34px_rgba(168,85,247,0.2)] transition duration-300 hover:-translate-y-0.5 hover:bg-violet-300/24">
                    Reservar reunión gratuita
                </a>
                <a href="#servicios" class="liquid-glass inline-flex min-h-12 items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white/82 no-underline transition duration-300 hover:-translate-y-0.5 hover:text-white">
                    Ver servicios
                </a>
            </div>
        </div>
    </div>
</section>

<script src="../scripts/solutions.js"></script>
