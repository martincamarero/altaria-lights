---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import WhatsAppButton from '../components/Whatsapp.astro';
import { injectSpeedInsights } from '@vercel/speed-insights';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonical?: string;
}

const {
	title,
	description = 'Creamos webs, software a medida e IA para empresas que quieren captar más clientes, automatizar procesos y crecer con soluciones digitales.',
	image = 'https://altarialights.com/og/altaria-og.jpg?v=3',
	canonical = 'https://altarialights.com/',
} = Astro.props;

injectSpeedInsights();
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={canonical} />

		<link
			rel="shortcut icon"
			href="/og/logo-fondo-negro.png?v=1"
			type="image/png"
		/>
		<link rel="icon" href="/og/logo-fondo-negro.png?v=1" type="image/png" />
		<meta name="theme-color" content="#05050A" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=Plus+Jakarta+Sans:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@1,8..60,400;1,8..60,500&display=swap"
			rel="stylesheet"
		/>

		<meta
			name="keywords"
			content="Altaria Lights, diseño web profesional, software a medida, inteligencia artificial para empresas, automatización de procesos, desarrollo web Toledo, marketing digital, soluciones digitales, transformación digital, páginas web para empresas, agencia digital, consultoría tecnológica"
		/>
		<meta name="author" content="Martín Camarero Benavente" />

		<!-- Open Graph / WhatsApp / Facebook / LinkedIn -->
		<meta property="og:site_name" content="Altaria Lights" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:secure_url" content={image} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Altaria Lights - Diseño web, software a medida e IA para empresas"
		/>
		<meta property="og:updated_time" content="2026-06-04T00:00:00+00:00" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta
			name="twitter:image:alt"
			content="Altaria Lights - Diseño web, software a medida e IA para empresas"
		/>

		<script
			src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs"
			type="module"
			defer></script>
	</head>

	<body class="bg-[#050505] text-white font-[var(--font-body)]">
		<div class="relative w-full overflow-x-clip">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
			<WhatsAppButton />
		</div>
		<Analytics />
	</body>
</html>
